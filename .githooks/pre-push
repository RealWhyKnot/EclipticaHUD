#!/usr/bin/env bash
set -euo pipefail
shopt -s inherit_errexit

root=$(git rev-parse --show-toplevel)
cd "${root}"
python -B .github/lint/style_check.py
typos --config .github/lint/typos.toml .
zizmor --offline --quiet .
gitleaks git --no-banner --redact --log-opts="--branches --not --remotes" .
cargo fmt --check
timeout 1200 cargo clippy --workspace --all-targets --locked -- -D warnings
timeout 1200 cargo test --workspace --all-targets --locked
timeout 600 cargo deny --locked check advisories bans sources
if [[ ${OSTYPE} == msys* || ${OSTYPE} == cygwin* ]]; then
  windows_root=$(pwd -W)
  MSYS_NO_PATHCONV=1 timeout 180 wsl --distribution "${LINT_WSL_DISTRO:?Set LINT_WSL_DISTRO to your lint distro}" \
    --cd "${windows_root}" -- bash .githooks/check-shell
else
  bash .githooks/check-shell
fi
